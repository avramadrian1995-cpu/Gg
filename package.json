{
  "name": "miseda-itp",
  "version": "1.0.0",
  "private": true,
  "description": "Programări ITP online, remindere și portal flote pentru stația ITP MISEDA INSPECT Rădăuți",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": { "node": ">=22.9" },
  "scripts": {
    "start": "node --no-warnings --env-file-if-exists=.env src/server.js",
    "dev": "node --no-warnings --env-file-if-exists=.env --watch src/server.js",
    "seed:demo": "node --no-warnings scripts/seed-demo.js",
    "test": "node --no-warnings --test"
  },
  "dependencies": {
    "express": "^4.21.2"
  }
}
