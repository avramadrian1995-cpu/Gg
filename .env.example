# Copiați în .env și completați. Toate sunt opționale.
PORT=3000
# Fișierul bazei de date SQLite
DB_FILE=data/miseda.db
# Primul cont de administrator (creat doar dacă nu există niciunul)
ADMIN_EMAIL=admin@misedainspectsrl.ro
ADMIN_PASSWORD=schimbati-aceasta-parola
# Adresa publică, folosită în linkurile din SMS
PUBLIC_URL=https://programari.misedainspectsrl.ro
# Setați 1 în producție, în spatele HTTPS / al unui reverse proxy
COOKIE_SECURE=1
TRUST_PROXY=1
# Trimitere SMS / e-mail: "log" (doar afișează) sau "webhook"
NOTIFY_PROVIDER=log
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=
